{
  "name": "better-auth-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack --no-lint",
    "start": "next start",
    "dbgui": "prisma studio --config ./prisma.config.ts",
    "db:push": "prisma db push",
    "auth": "npx auth secret",
    "prisma:init": "prisma init --datasource-provider postgresql --output ../generated/prisma",
    "auth:generate": "npx @better-auth/cli generate",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "pp": "prisma",
    "lint": "eslint"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@prisma/adapter-better-sqlite3": "7.2.0",
    "@prisma/adapter-pg": "7.6.0",
    "@prisma/client": "7.6.0",
    "antd": "^6.3.5",
    "axios": "^1.14.0",
    "better-auth": "^1.5.6",
    "better-sqlite3": "12.6.0",
    "clsx": "^2.1.1",
    "date-fns": "2.29.3",
    "dayjs": "^1.11.20",
    "dotenv": "17.2.3",
    "immer": "^11.1.4",
    "jose": "6.1.3",
    "next": "^16.2.2",
    "nodemailer": "7.0.12",
    "pg": "8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-query": "3.39.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "7.0.5",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.2",
    "postcss": "8.5.6",
    "prisma": "7.6.0",
    "tailwindcss": "^4.2.2",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
